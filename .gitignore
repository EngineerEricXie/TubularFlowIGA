# Executables. The Makefiles build binaries beside their sources, so every
# extension-less file directly under solvers/<backend>/ is a build product.
# Tracked files at that level always have an extension or are Makefiles.
/solvers/*/*
!/solvers/*/*/
!/solvers/*/*.*
!/solvers/*/Makefile
/preprocessing/mesh/tubular_mesh
/preprocessing/mesh/mesh_core_test
/preprocessing/spline/spline

