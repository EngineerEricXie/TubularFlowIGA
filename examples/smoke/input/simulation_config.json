{
  "schema_version": 2,
  "fields": [
    {"name": "velocity", "kind": "vector3"},
    {"name": "pressure", "kind": "pressure"},
    {"name": "tracer", "kind": "scalar", "initial_value": 0.0}
  ],
  "time": {"dt": 0.1, "steps": 2},
  "equation_systems": [
    {
      "name": "blood_flow",
      "kind": "navier_stokes",
      "unknowns": ["velocity", "pressure"],
      "viscosity": 0.1
    },
    {
      "name": "tracer_transport",
      "kind": "linear_transport",
      "unknowns": ["tracer"],
      "terms": [
        {"operator": "time_derivative", "equation": "tracer"},
        {"operator": "diffusion", "equation": "tracer", "coefficient": 1.0},
        {"operator": "advection", "equation": "tracer", "velocity": "prescribed"}
      ],
      "stabilization": [
        {"equation": "tracer", "method": "supg", "velocity": "prescribed"}
      ]
    }
  ],
  "boundaries": [
    {
      "label": 0,
      "name": "vessel_wall",
      "conditions": [
        {"field": "velocity", "type": "dirichlet", "value": [0.0, 0.0, 0.0]},
        {"field": "tracer", "type": "no_flux"}
      ]
    },
    {
      "label": 1,
      "name": "inlet",
      "conditions": [
        {"field": "velocity", "type": "dirichlet", "profile": "initial_velocityfield.txt", "scale": 1.0},
        {"field": "tracer", "type": "dirichlet", "value": 1.0}
      ]
    },
    {
      "label": 2,
      "name": "outlet",
      "conditions": [
        {"field": "pressure", "type": "dirichlet", "value": 0.0},
        {"field": "tracer", "type": "advective_outflow"}
      ]
    }
  ]
}
