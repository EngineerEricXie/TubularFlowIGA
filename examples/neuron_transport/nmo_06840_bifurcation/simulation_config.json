      {"field": "Nplus", "type": "dirichlet", "value": 2.0}
    ]},
    {"label": 2, "name": "outlet_a", "conditions": [
      {"field": "N0", "type": "advective_outflow"},
      {"field": "Nplus", "type": "advective_outflow"}
    ]},
    {"label": 3, "name": "outlet_b", "conditions": [
