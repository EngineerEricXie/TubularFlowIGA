        {"operator": "advection", "equation": "Nplus", "velocity": "prescribed"},
        {"operator": "linear_coupling", "equation": "Nplus", "trial": "N0", "coefficient": -1.0},
        {"operator": "linear_coupling", "equation": "Nplus", "trial": "Nplus", "coefficient": 0.1}
      ],
      "stabilization": [
        {"equation": "Nplus", "method": "supg", "velocity": "prescribed"}
      ]
    }
  ],
  "boundaries": [
