{
  "schema_version": 3,
  "dimension": "1d",
  "geometry": {
    "kind": "swc_network",
    "file": "skeleton_initial.swc",
    "length_scale_to_m": 1.0
  },
  "fields": [
    {"name": "area", "kind": "scalar"},
    {"name": "flow_rate", "kind": "scalar"},
    {"name": "pressure", "kind": "pressure"}
  ],
  "time": {"dt": 0.001, "steps": 20, "output_every": 2},
  "temporal_functions": [
    {
      "name": "inlet_pulse",
      "kind": "sinusoid",
      "units": "m3/s",
      "mean": 1.0e-8,
      "amplitude": 2.0e-9,
      "period": 0.02,
      "phase": 0.0
    }
  ],
  "equation_systems": [
    {
      "name": "blood_flow_1d",
      "kind": "network_flow_1d",
      "unknowns": ["area", "flow_rate", "pressure"],
      "model": "compliant",
      "scheme": "explicit_rusanov",
      "dynamic_viscosity": 0.004,
      "density": 1060.0,
      "wall": {
        "model": "linear",
        "young_modulus": 1000000.0,
        "thickness_ratio": 0.1,
        "reference_pressure": 0.0
      },
      "discretization": {
        "cells_per_segment": 4,
        "cfl": 0.75,
        "alpha": 1.3333333333333333,
        "min_area_fraction": 0.2
      },
      "junctions": {
        "pressure_balance": "static",
        "loss_model": "angle_sin2",
        "coefficient": 0.2,
        "reference_velocity": "parent"
      }
    }
  ],
  "boundaries": [
    {
      "name": "inlet",
      "role": "inlet",
      "node_ids": [1],
      "conditions": [
        {"field": "flow_rate", "type": "dirichlet", "quantity": "flow_rate", "waveform": "inlet_pulse"}
      ]
    },
    {
      "name": "terminal_beds",
      "role": "outlet",
      "node_ids": [3, 4],
      "conditions": [
        {
          "field": "pressure",
          "type": "windkessel_rcr",
          "proximal_resistance": 1.0e8,
          "distal_resistance": 1.0e9,
          "capacitance": 1.0e-10,
          "reference_pressure": 0.0,
          "initial_pressure": 0.0
        }
      ]
    }
  ]
}
